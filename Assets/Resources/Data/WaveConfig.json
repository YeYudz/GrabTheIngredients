{
  "version": 1,
  "_comment": "波次表（关卡内共享）。triggersBoss=true 的波次即「BOSS 波」：先刷该波小怪，清空后生成 bossId 指定的 BOSS；该波被关卡阶段配置引用为阶段的最后一波。波次模板 = 2 阶段 x 7 波：waveId 1~7 = 阶段一，waveId 8~14 = 阶段二，每阶段第 7 波为 BOSS 前置波。",
  "_countCurve": "人数 = 50 x 1.176^(waveId-1)，BOSS 前置波（7/14）x0.5。前段（1~6）533 只 / 后段（8~13）1660 只 = 3.11 倍 —— 后期指数蜂拥，前期轻量教学。",
  "_spawnPacing": "生成速度（只/秒）是显式变量：线性段每波 +0.30 只/秒；达到软上限 3.6 后进入渐进段，每波只补齐 剩余差距 的 4.5%，硬上限 5.5（= 最小间隔 0.182s，保帧率与可读性）。波 1 = 0.96 只/秒（间隔 1.04s） -> 波 13 = 3.92 只/秒（间隔 0.255s）。",
  "_budget": "刷怪窗口合计 750s + 准备 60s = 810s（不含清场）；清场按 +16% 估 120s；2 场 BOSS 300s ⇒ 单局 ≈ 1230s ≈ 20.5 分钟。总敌数 2193 只，总经验 8339 → 可拾取 7671，升 10 级需 7081（余量 8.3%）。",
  "maxAlive": 70,
  "spawnPacing": {
    "_desc": "生成速度曲线：线性段 -> 软上限后渐进收紧 -> 硬上限。rateSoftCap/rateHardCap <=0 表示对应段不启用。",
    "baseSpawnRate": 0.96,
    "spawnRateGainPerWave": 0.3,
    "rateSoftCap": 3.6,
    "rateTightenPerWave": 0.045,
    "rateHardCap": 5.5,
    "firstWave": 1
  },
  "waveStatGrowth": {
    "_desc": "每经过一波，敌人属性按固定倍率提升（乘法叠加，与副本难度/词缀相乘）。波 14 时血量 x1.77、攻击 x2.01 —— 这是后期威胁的主要来源，血量刻意压低以保「一击割草」的手感，压力靠数量与攻击。",
    "hpPerWave": 1.045,
    "damagePerWave": 1.055,
    "expPerWave": 1.0,
    "startWave": 1
